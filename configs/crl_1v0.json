{
  "schema_version": 7,
  "obs_schema_version": 2,
  "env": {
    "mode": "soccar",
    "collision_meshes_path": "collision_meshes",
    "team_size": 1,
    "tick_skip": 8,
    "tick_rate": 120,
    "max_episode_ticks": 2250,
    "no_touch_timeout_seconds": 10.0,
    "no_touch_timeout_only_before_first_touch": false,
    "spawn_opponents": false,
    "randomize_kickoffs": true,
    "seed": 0
  },
  "outcome": {
    "score": 1.0,
    "concede": 0.0,
    "neutral": 0.0,
    "neutral_no_touch": 0.0,
    "team_spirit": 0.0,
    "step_penalty": 0.0
  },
  "action_table": {
    "builtin": "rlgym_lookup_v1"
  },
  "model": {
    "observation_dim": 172,
    "action_dim": 90,
    "use_layer_norm": true,
    "encoder_dim": 256,
    "num_encoder_blocks": 2,
    "sequence_length": 16,
    "max_forward_samples": 16384,
    "value_hidden_dim": 256,
    "policy_hidden_dim": 0
  },
  "ppo": {
    "num_envs": 1536,
    "collection_workers": 24,
    "collection_shards": 4,
    "init_checkpoint": "",
    "rollout_length": 256,
    "minibatch_size": 65536,
    "update_epochs": 1,
    "optimizer_accumulation_steps": 2,
    "clip_range": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 1.0,
    "value_loss_delta": 10.0,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "learning_rate": 3e-4,
    "overbatching": true,
    "policy_temperature": 1.0,
    "max_grad_norm": 1.0,
    "device": "cuda",
    "checkpoint_interval": 50,
    "max_rolling_checkpoints": 5,
    "synchronize_cuda_timing": false,
    "cuda_amp": false,
    "max_policy_log_ratio": 5.0,
    "target_kl": 0.0,
    "overlap_collection_update": true,
    "anchor_eval_interval": 0,
    "anchor_eval_envs": 0,
    "anchor_eval_steps": 0,
    "anchor_update_threshold": 0.65
  },
  "goal_mapping": {
    "arena_max_distance": 8192.0,
    "goal_dim": 4
  },
  "goal_critic": {
    "goal_dim": 4,
    "hidden_dim": 256,
    "embedding_dim": 256,
    "logsumexp_penalty_coeff": 0.01,
    "lambda_Zg": 1.0,
    "lambda_goal_actor": 1.0,
    "contrastive_batch_size": 1024,
    "max_future_horizon": 256,
    "temperature": 0.1
  },
  "es_lora": {
    "rank": 4,
    "lora_alpha": 4.0,
    "population_size": 8,
    "virtual_population_waves": 1,
    "sigma_ES": 0.05,
    "eta_ES": 0.003,
    "es_interval": 0,
    "eval_shards": 0,
    "eval_workers": 0,
    "eval_episodes_per_member": 2,
    "eval_num_envs": 8,
    "eval_rollout_length": 450,
    "kl_eval_stride": 1,
    "beta_KL": 0.01,
    "rank_transform": false,
    "antithetic_sampling": true,
    "update_norm_clip": true,
    "max_update_norm": 0.002,
    "max_kl_mean": 0.01,
    "require_fitness_signal": true,
    "min_fitness_std": 1e-6
  },
  "wandb": {
    "enabled": true,
    "project": "pulsar-crl",
    "mode": "online"
  },
  "replay_buffer": {
    "max_episodes": 2048,
    "max_episode_length": 300,
    "min_episodes_before_sampling": 32,
    "max_future_horizon": 256
  },
  "crl": {
    "enabled": true,
    "car_head_initial_weight": 1.0,
    "car_head_anneal_steps": 1000000000.0,
    "num_updates_per_rollout": 4,
    "car_goal_dim": 3
  }
}
