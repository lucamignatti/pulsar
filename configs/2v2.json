{
  "schema_version": 6,
  "obs_schema_version": 2,
  "env": {
    "mode": "soccar",
    "collision_meshes_path": "collision_meshes",
    "team_size": 1,
    "tick_skip": 8,
    "tick_rate": 120,
    "max_episode_ticks": 36000,
    "no_touch_timeout_seconds": 30.0,
    "no_touch_timeout_only_before_first_touch": true,
    "spawn_opponents": true,
    "randomize_kickoffs": true,
    "seed": 67
  },
  "outcome": {
    "score": 20.0,
    "concede": -16.0,
    "neutral": 0.0,
    "neutral_no_touch": -4.0,
    "team_spirit": 0.1,
    "step_penalty": -0.01
  },
  "action_table": {
    "builtin": "rlgym_lookup_v1"
  },
  "model": {
    "observation_dim": 172,
    "action_dim": 90,
    "use_layer_norm": true,
    "encoder_dim": 384,
    "num_encoder_blocks": 3,
    "sequence_length": 16,
    "max_forward_samples": 16384,
    "value_hidden_dim": 512,
    "policy_hidden_dim": 0
  },
  "ppo": {
    "num_envs": 1536,
    "collection_workers": 24,
    "collection_shards": 4,
    "init_checkpoint": "",
    "rollout_length": 256,
    "minibatch_size": 65536,
    "update_epochs": 1,
    "optimizer_accumulation_steps": 2,
    "clip_range": 0.2,
    "entropy_coef": 0.02,
    "value_coef": 0.25,
    "value_loss_delta": 10.0,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "learning_rate": 0.0001,
    "overbatching": true,
    "policy_temperature": 1.0,
    "max_grad_norm": 1.0,
    "device": "cuda",
    "checkpoint_interval": 50,
    "max_rolling_checkpoints": 3,
    "synchronize_cuda_timing": false,
    "cuda_amp": false,
    "max_policy_log_ratio": 2.0,
    "target_kl": 0.0,
    "overlap_collection_update": true,
    "anchor_eval_interval": 50,
    "anchor_eval_envs": 16,
    "anchor_eval_steps": 1800,
    "anchor_update_threshold": 0.65
  },
  "goal_mapping": {
    "arena_max_distance": 8192.0,
    "goal_dim": 4
  },
  "goal_critic": {
    "goal_dim": 4,
    "hidden_dim": 768,
    "embedding_dim": 1024,
    "logsumexp_penalty_coeff": 0.01,
    "lambda_Zg": 1.0,
    "lambda_goal_actor": 1.0,
    "contrastive_batch_size": 4096,
    "max_future_horizon": 256
  },
  "es_lora": {
    "rank": 4,
    "lora_alpha": 4.0,
    "population_size": 512,
    "virtual_population_waves": 1,
    "sigma_ES": 0.01,
    "eta_ES": 0.001,
    "es_interval": 25,
    "eval_shards": 4,
    "eval_workers": 8,
    "eval_episodes_per_member": 2,
    "eval_num_envs": 2,
    "eval_rollout_length": 300,
    "kl_eval_stride": 4,
    "beta_KL": 0.0025,
    "rank_transform": true,
    "antithetic_sampling": true,
    "update_norm_clip": true,
    "max_update_norm": 0.001,
    "max_kl_mean": 0.01,
    "require_fitness_signal": true,
    "min_fitness_std": 1e-6
  },
  "wandb": {
    "enabled": true
  }
}
