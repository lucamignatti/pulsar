{
  "schema_version": 6,
  "obs_schema_version": 2,
  "env": {
    "mode": "soccar",
    "collision_meshes_path": "collision_meshes",
    "team_size": 2,
    "tick_skip": 8,
    "tick_rate": 120,
    "max_episode_ticks": 2250,
    "no_touch_timeout_seconds": 10.0,
    "spawn_opponents": true,
    "randomize_kickoffs": true,
    "seed": 7
  },
  "outcome": {
    "score": 0.0,
    "concede": 0.0,
    "neutral": 1.0,
    "neutral_no_touch": -1.0
  },
  "mechanic_rewards": {
    "kickoff_first_touch": 0.0,
    "speed_flip": 0.0,
    "wavedash": 0.0,
    "chain_dash_bonus": 0.0,
    "half_flip": 0.0,
    "wall_dash": 0.0,
    "air_dribble_base": 0.0,
    "air_dribble_scale": 0.0,
    "flip_reset": 0.0,
    "ceiling_shot": 0.0,
    "double_tap": 0.0,
    "preflip": 0.0,
    "redirect": 0.0,
    "pogo": 0.0,
    "pinch": 0.0,
    "team_pinch": 0.0,
    "mechanic_reward_cap_per_episode": 0.0
  },
  "curriculum": {
    "enabled": true,
    "stages": [
      {
        "name": "touch_bootstrap",
        "outcome_override": { "score": 0.0, "concede": 0.0, "neutral": 1.0, "neutral_no_touch": -1.0 },
        "mechanic_rewards_override": {
          "kickoff_first_touch": 0.0, "speed_flip": 0.0, "wavedash": 0.0,
          "chain_dash_bonus": 0.0, "half_flip": 0.0, "wall_dash": 0.0,
          "air_dribble_base": 0.0, "air_dribble_scale": 0.0, "flip_reset": 0.0,
          "ceiling_shot": 0.0, "double_tap": 0.0, "preflip": 0.0,
          "redirect": 0.0, "pogo": 0.0, "pinch": 0.0, "team_pinch": 0.0,
          "mechanic_reward_cap_per_episode": 0.0
        },
        "learning_rate": 0.0002,
        "min_agent_steps": 20000000,
        "promotion_window_updates": 5,
        "required_touch_episode_rate": 0.90,
        "required_scored_episode_rate": 0.0
      },
      {
        "name": "score_only",
        "outcome_override": { "score": 1.0, "concede": -0.8, "neutral": 0.0, "neutral_no_touch": 0.0 },
        "mechanic_rewards_override": {
          "kickoff_first_touch": 0.0, "speed_flip": 0.0, "wavedash": 0.0,
          "chain_dash_bonus": 0.0, "half_flip": 0.0, "wall_dash": 0.0,
          "air_dribble_base": 0.0, "air_dribble_scale": 0.0, "flip_reset": 0.0,
          "ceiling_shot": 0.0, "double_tap": 0.0, "preflip": 0.0,
          "redirect": 0.0, "pogo": 0.0, "pinch": 0.0, "team_pinch": 0.0,
          "mechanic_reward_cap_per_episode": 0.0
        },
        "learning_rate": 0.0001,
        "min_agent_steps": 30000000,
        "promotion_window_updates": 5,
        "required_touch_episode_rate": 0.0,
        "required_scored_episode_rate": 0.15
      },
      {
        "name": "mechanics_capped",
        "outcome_override": { "score": 1.0, "concede": -0.8, "neutral": 0.0, "neutral_no_touch": 0.0 },
        "mechanic_rewards_override": {
          "kickoff_first_touch": 0.0, "speed_flip": 0.01, "wavedash": 0.01,
          "chain_dash_bonus": 0.005, "half_flip": 0.01, "wall_dash": 0.01,
          "air_dribble_base": 0.02, "air_dribble_scale": 0.005, "flip_reset": 0.03,
          "ceiling_shot": 0.03, "double_tap": 0.02, "preflip": 0.01,
          "redirect": 0.02, "pogo": 0.02, "pinch": 0.02, "team_pinch": 0.02,
          "mechanic_reward_cap_per_episode": 0.10
        },
        "learning_rate": 0.0001,
        "min_agent_steps": 0,
        "promotion_window_updates": 0,
        "required_touch_episode_rate": 0.0,
        "required_scored_episode_rate": 0.0
      }
    ]
  },
  "action_table": {
    "builtin": "rlgym_lookup_v1",
    "actions": []
  },
  "model": {
    "observation_dim": 132,
    "action_dim": 90,
    "use_layer_norm": true,
    "encoder_dim": 256,
    "num_encoder_blocks": 2,
    "transformer_num_heads": 8,
    "transformer_window_size": 4,
    "transformer_max_batch_size": 4096,
    "transformer_token_group_size": 4,
    "transformer_ffn_multiplier": 2,
    "value_hidden_dim": 256,
    "policy_hidden_dim": 0
  },
  "ppo": {
    "num_envs": 256,
    "collection_workers": 24,
    "collection_shards": 4,
    "init_checkpoint": "",
    "rollout_length": 128,
    "minibatch_size": 65536,
    "update_epochs": 1,
    "clip_range": 0.1,
    "entropy_coef": 0.02,
    "entropy_floor": 0.25,
    "entropy_floor_coef": 0.05,
    "value_coef": 0.5,
    "gamma": 0.997,
    "gae_lambda": 0.95,
    "learning_rate": 0.0002,
    "max_grad_norm": 0.5,
    "device": "cuda",
    "checkpoint_interval": 100,
    "max_rolling_checkpoints": 5,
    "early_update_completed_episodes": 64,
    "train_only_scored_episodes": false,
    "use_adaptive_epsilon": false,
    "use_confidence_weighting": false,
    "synchronize_cuda_timing": false,
    "adaptive_entropy": true,
    "entropy_decay_score": 0.60,
    "entropy_low_coef": 0.002,
    "plasticity": true,
    "plasticity_interval": 40,
    "plasticity_shrink": 0.999,
    "plasticity_noise": 0.0001,
    "pcgrad": true,
    "success_bc_coef": 0.1,
    "success_bc_batch": 256,
    "success_buffer_size": 20000,
    "success_bc_min_score": 0.25,
    "success_bc_decay_score": 0.95,
    "success_bc_decay": 0.25,
    "success_trace_len": 48
  },
  "goal_mapping": {
    "arena_max_distance": 8192.0
  },
  "goal_critic": {
    "goal_dim": 3,
    "hidden_dim": 256,
    "embedding_dim": 64,
    "logsumexp_penalty_coeff": 0.01,
    "lambda_Zg": 1.0,
    "lambda_goal_actor": 0.1,
    "contrastive_batch_size": 2048,
    "max_future_horizon": 10000000
  },
  "es_lora": {
    "rank": 4,
    "lora_alpha": 4.0,
    "population_size": 16,
    "sigma_ES": 0.01,
    "eta_ES": 0.003,
    "es_interval": 100,
    "eval_episodes_per_member": 4,
    "eval_num_envs": 8,
    "eval_rollout_length": 450,
    "beta_KL": 1.0,
    "antithetic_sampling": true,
    "update_norm_clip": true,
    "max_update_norm": 0.002,
    "max_kl_mean": 0.01,
    "require_winrate_signal": true,
    "min_winrate_std": 1e-6
  },
  "self_play_league": {
    "enabled": true,
    "opponent_probability": 0.5,
    "snapshot_interval_updates": 50,
    "max_snapshots": 8,
    "training_opponent_policy": "stochastic",
    "eval_interval_updates": 50,
    "eval_num_envs": 8,
    "eval_matches_per_snapshot": 4,
    "eval_policy": "stochastic",
    "elo_initial": 1000.0,
    "elo_k": 32.0
  },
  "wandb": {
    "enabled": true,
    "project": "pulsar",
    "entity": "",
    "run_name": "stage0-touch-bootstrap",
    "group": "curriculum",
    "job_type": "train",
    "dir": "",
    "mode": "online",
    "python_executable": "python3",
    "script_path": "scripts/wandb_stream.py",
    "log_interval_seconds": 30.0,
    "tags": ["curriculum", "stage0", "touch-bootstrap", "2v2"]
  }
}
